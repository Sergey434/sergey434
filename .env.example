# Скопируйте в .env и заполните. Файл .env не коммитится.

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=
SUPPORT_CONTACT=@your_support

# --- Модели ---
# Ключ с https://openrouter.ai/keys. Пусто = тестовый режим (заглушки вместо ответов, без затрат)
OPENROUTER_API_KEY=
DEFAULT_MODEL=openai/gpt-4o-mini
PUBLIC_URL=

# --- Секреты (сгенерируйте: openssl rand -hex 32) ---
SERVICE_TOKEN=
JWT_SECRET=
POSTGRES_PASSWORD=aggregator

# --- Экономика (баланс в копейках) ---
USD_RUB_RATE=100
MARKUP=2.0
WELCOME_BONUS_KOPECKS=1000
STARS_PACKS=50,100,250,500
KOPECKS_PER_STAR=100

# --- Ограничения ---
RATE_LIMIT_PER_MINUTE=20
HISTORY_MESSAGES=20

# --- Веб (позже) ---
CORS_ORIGINS=
